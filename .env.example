# ============================================================
# AEROS — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- AI Providers ---
NVIDIA_API_KEY=nvapi-your-key-here
DEFAULT_CHAT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
DEFAULT_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
DEFAULT_EMBED_MODEL=nvidia/nv-embed-v1

GROQ_API_KEY=gsk_your-key-here

# --- Server ---
AEROS_HOST=0.0.0.0
AEROS_PORT=4040
AEROS_DEBUG=true

# --- Database ---
AEROS_DATABASE_URL=sqlite:///data/aeros.db

# --- Auth ---
AEROS_JWT_SECRET=change-me-to-a-random-secret
AEROS_JWT_ACCESS_TTL_MIN=15
AEROS_JWT_REFRESH_TTL_DAYS=7
AEROS_HMAC_SECRET=change-me-to-a-different-random-secret

# --- Email (SMTP outbound) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_ADDRESS=procurement@aeros.local

# --- Email (IMAP inbound) ---
IMAP_HOST=localhost
IMAP_PORT=1143
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_SEC=30

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Storage ---
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=25
