# ============================================================
# AEROS — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- AI Providers ---
# Chat + vision: MiMo by default (any OpenAI-compatible endpoint works here)
AEROS_MIMO_API_KEY=
AEROS_MIMO_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
AEROS_DEFAULT_CHAT_MODEL=mimo-v2.5
AEROS_DEFAULT_VISION_MODEL=mimo-v2.5

# Embeddings: NVIDIA NIM (vendor-by-SKU matching)
AEROS_NVIDIA_API_KEY=nvapi-your-key-here
AEROS_DEFAULT_EMBED_MODEL=nvidia/nv-embed-v1

# Voice input ASR: Groq Whisper
AEROS_GROQ_API_KEY=gsk_your-key-here

# --- Server ---
AEROS_HOST=0.0.0.0
AEROS_PORT=4040
AEROS_DEBUG=true

# --- Database ---
AEROS_DATABASE_URL=sqlite:///data/aeros.db

# --- Auth ---
AEROS_JWT_SECRET=change-me-to-a-random-secret
AEROS_JWT_ACCESS_TTL_MIN=15
AEROS_JWT_REFRESH_TTL_DAYS=7
AEROS_HMAC_SECRET=change-me-to-a-different-random-secret

# --- Email (SMTP outbound) ---
AEROS_SMTP_HOST=localhost
AEROS_SMTP_PORT=1025
AEROS_SMTP_USERNAME=
AEROS_SMTP_PASSWORD=
AEROS_SMTP_USE_TLS=false
AEROS_SMTP_FROM_ADDRESS=procurement@aeros.local

# --- Email (IMAP inbound) ---
AEROS_IMAP_HOST=localhost
AEROS_IMAP_PORT=1143
AEROS_IMAP_USERNAME=
AEROS_IMAP_PASSWORD=
AEROS_IMAP_POLL_INTERVAL_SEC=30

# --- Telegram (optional) ---
AEROS_TELEGRAM_BOT_TOKEN=
AEROS_TELEGRAM_WEBHOOK_SECRET=

# --- Frontend ---
AEROS_FRONTEND_URL=http://localhost:5173
AEROS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Storage ---
AEROS_UPLOAD_DIR=data/uploads
AEROS_MAX_UPLOAD_SIZE_MB=25
