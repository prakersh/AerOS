# ============================================================
# AEROS — .gitignore
# Security first: never commit secrets, credentials, or PII.
# ============================================================

# --- Secrets & credentials (CRITICAL) ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/
*.credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Virtual envs ---
.venv/
venv/
env/
ENV/

# --- uv / pip ---
.uv-cache/
pip-log.txt
pip-delete-this-directory.txt

# --- Node / pnpm / npm / yarn ---
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-integrity
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Frontend build artifacts ---
frontend/dist/
frontend/build/
frontend/.vite/
frontend/coverage/
frontend/.turbo/
.next/
.nuxt/

# --- Playwright ---
playwright-report/
test-results/
.playwright-mcp/

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & PIDs ---
*.log
logs/
.pids/
*.pid

# --- Runtime data (DBs, uploads, generated files) ---
data/
!data/.gitkeep
uploads/
!uploads/.gitkeep
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal

# --- Huey ---
huey.db
huey-state/

# --- Alembic generated (keep versions/, ignore stamps) ---
# alembic/versions/ is COMMITTED; nothing to ignore here

# --- VCR cassettes are COMMITTED (deterministic test replay) ---
# tests/fixtures/vcr/*.yaml stays tracked

# --- Misc generated ---
gen.log
MagicMock/
ui-test-screenshots/
dist/
*.png
# Test fixtures must be tracked even though *.png is ignored.
!tests/fixtures/vendor_quotes/*.png

# --- Backups ---
*.bak
*.backup
*.orig
*.rej
